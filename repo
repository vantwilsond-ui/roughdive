const scopeNumber = (v:number,low:number,high:number):number => Math.max(low,Math.min(high,Number.isFinite(Number(v))?Number(v):low));
const mapWhere = (cfg:MapConfig):string => {
  const selected = EVENT_DEFINITIONS.filter((d) => cfg.eventKeys.includes(d.id));
  const parts:string[] = ['(' + (selected.length ? selected.map((d)=>'('+d.predicate+')').join(' OR ') : 'FALSE') + ')','has_location = TRUE'];
  if (['arrows','destinations','routes','sonar'].includes(cfg.mapType)) parts.push('has_end_location = TRUE','is_pass = TRUE');
  if (cfg.outcome === 'successful') parts.push('is_successful = TRUE');
  if (cfg.outcome === 'unsuccessful') parts.push('is_successful = FALSE');
  if (cfg.playType === 'open') parts.push('source_set_piece_type IS NULL');
  if (cfg.playType === 'set') parts.push('source_set_piece_type IS NOT NULL');
  if (cfg.playType === 'corner') parts.push("source_set_piece_type = 'Corner'");
  if (cfg.playType === 'freekick') parts.push("source_set_piece_type IN ('Freekick','IndirectFreekick','DirectFreekick')");
  parts.push('expanded_minute BETWEEN '+scopeNumber(cfg.fromMinute,0,140)+' AND '+scopeNumber(cfg.toMinute,0,140));
  if (cfg.category === 'Passing') {
    if (cfg.direction === 'forward') parts.push('has_end_location AND attack_end_x - attack_x > 3');
    if (cfg.direction === 'backward') parts.push('has_end_location AND attack_end_x - attack_x < -3');
    if (cfg.direction === 'lateral') parts.push('has_end_location AND ABS(attack_end_x - attack_x) <= 3');
    if (cfg.minDistance > 0 || cfg.maxDistance < 140)
      parts.push('has_end_location AND SQRT(POW(attack_end_x-attack_x,2)+POW(attack_end_y-attack_y,2)) BETWEEN '+scopeNumber(cfg.minDistance,0,140)+' AND '+scopeNumber(cfg.maxDistance,0,140));
  }
  if (cfg.startThird !== 'all') parts.push("start_third = '"+safe(cfg.startThird)+"'");
  if (cfg.endThird !== 'all' && cfg.category === 'Passing') parts.push("end_third = '"+safe(cfg.endThird)+"'");
  if (cfg.startLane !== 'all') parts.push("start_lane = '"+(cfg.startLane==='left'?'right':cfg.startLane==='right'?'left':'center')+"'");
  if (cfg.endLane !== 'all' && cfg.category === 'Passing') parts.push("end_lane = '"+(cfg.endLane==='left'?'right':cfg.endLane==='right'?'left':'center')+"'");
  if (cfg.startZone > 0) parts.push('start_zone_18 = '+scopeNumber(cfg.startZone,1,18));
  if (cfg.endZone > 0 && cfg.category === 'Passing') parts.push('end_zone_18 = '+scopeNumber(cfg.endZone,1,18));
  return parts.join(' AND ');
};
const mapLabel = (cfg:MapConfig):string =>
  EVENT_DEFINITIONS.filter((d)=>cfg.eventKeys.includes(d.id)).map((d)=>d.label).join(' + ') || 'No event selected';
const plotXY = (ev:Row, end=false):[number,number] => {
  const x = N(end ? ev.attack_end_x : ev.attack_x);
  const y = N(end ? ev.attack_end_y : ev.attack_y);
  // The canonical lateral axis is reversed relative to an attacking-up pitch: low attack_y is the player's right flank.
  return [67-0.64*scopeNumber(y,0,100),3+1.04*(100-scopeNumber(x,0,100))];
};
const cellCounts = (data:Row[], cols:number, bands:number, end=false):number[] => {
  const cells = Array(cols*bands).fill(0) as number[];
  data.forEach((ev)=> {
    const [x,y] = plotXY(ev,end);
    const col=Math.min(cols-1,Math.max(0,Math.floor(((x-3)/64)*cols)));
    const band=Math.min(bands-1,Math.max(0,Math.floor(((y-3)/104)*bands)));
    cells[band*cols+col] += 1;
  });
  return cells;
};
const routeRows = (events:Row[]) => {
  const groups:Record<string,{n:number;sx:number;sy:number;ex:number;ey:number}>={};
  events.forEach((ev) => {
    if(ev.attack_end_x==null || ev.attack_end_y==null) return;
    const key=String(ev.start_zone_18||0)+'-'+String(ev.end_zone_18||0);
    const v=groups[key]||(groups[key]={n:0,sx:0,sy:0,ex:0,ey:0});
    const [sx,sy]=plotXY(ev),[ex,ey]=plotXY(ev,true);
    v.n++; v.sx+=sx;v.sy+=sy;v.ex+=ex;v.ey+=ey;
  });
  return Object.values(groups).sort((a,b)=>b.n-a.n).slice(0,14);
};
const sonarCounts = (events:Row[]):number[] => {
  const counts=Array(24).fill(0) as number[];
  events.forEach((ev) => {
    if(ev.attack_end_x==null || ev.attack_end_y==null) return;
    // Mirror lateral vectors to agree with plotXY and the displayed attacking-up pitch.
    const dx=N(ev.attack_y)-N(ev.attack_end_y);
    const dy=-(N(ev.attack_end_x)-N(ev.attack_x));
    if(Math.hypot(dx,dy)<1) return;
    const angle=(Math.atan2(dy,dx)+Math.PI*2)%(Math.PI*2);
    counts[Math.floor(angle/(Math.PI*2)*24)%24]++;
  });
  return counts;
};
// Darken pale club colors just enough to read clearly on warm-white pitch paper.
const clubMapStroke = (color:string):string => {
  let ink = color;
  for (let i=0; i<12 && contrastRatio(ink,'#F8F5EF')<3.6; i++)
    ink = mixHex(ink,'#25313D',0.13);
  return ink;
};
function EventPitch({data,config,color,sharedMax,instanceId}: {data:Row[];config:MapConfig;color:string;sharedMax:number;instanceId:string}) {
  const [sliceStart,sliceEnd] = config.pitchView==='attacking' ? [0,55] : config.pitchView==='final' ? [0,39] : [0,110];
  const gridMode=config.mapType==='zones' ? [3,6] : [7,10];
  const cell=cellCounts(data,gridMode[0],gridMode[1],config.mapType==='destinations');
  const routes=routeRows(data);
  const sonar=sonarCounts(data);
  const fillColor=config.colorMode==='outcome'?'#238A70':clubMapStroke(color);
  const markerId='event-head-'+config.id+'-'+instanceId.replace(/[^a-zA-Z0-9_-]/g,'');
  const pitchEvents=data.slice(0,1200);
  const opacity=scopeNumber(config.opacity/100,0,1);
  const showThirdLine=config.eventKeys.includes('final_third_pass');
  const strokeFor=(ev:Row):string => config.colorMode==='outcome' ? (ev.is_successful?'#188269':'#BB5C54') : fillColor;
  return <svg className="event-pitch-svg" viewBox={'0 '+sliceStart+' 70 '+(sliceEnd-sliceStart)} role="img" aria-label={mapLabel(config)+' event map, attacking upwards'}>
    <defs>
      {[['club',fillColor],['win','#188269'],['lose','#BB5C54']].map(([key,tint])=>
        <marker key={key} id={markerId+'-'+key} markerUnits="userSpaceOnUse" viewBox="0 0 8 8" refX="7.5" refY="4" markerWidth="1.35" markerHeight="1.35" orient="auto">
          <path d="M0 0 L8 4 L0 8 Z" fill={tint}/>
        </marker>)}
    </defs>
    <rect width="70" height="110" fill="#F8F5EF"/>
    <g stroke="#655F58" strokeWidth=".27" fill="none" opacity=".91">
      <rect x="3" y="3" width="64" height="104"/>
      <line x1="3" y1="55" x2="67" y2="55"/>
      <circle cx="35" cy="55" r="8.5"/>
      <rect x="16" y="3" width="38" height="18"/><rect x="24" y="3" width="22" height="7"/>
      <rect x="16" y="89" width="38" height="18"/><rect x="24" y="100" width="22" height="7"/>
      <rect x="29" y="1" width="12" height="2"/><rect x="29" y="107" width="12" height="2"/>
      <path d="M 27 21 A 9 9 0 0 0 43 21"/><path d="M 27 89 A 9 9 0 0 1 43 89"/>
    </g>
    <g fill="#655F58"><circle cx="35" cy="55" r=".48"/><circle cx="35" cy="14.5" r=".48"/><circle cx="35" cy="95.5" r=".48"/></g>
    {showThirdLine && <line x1="3" y1={3+104/3} x2="67" y2={3+104/3} stroke="#8C837A" strokeWidth=".25" strokeDasharray="1 1.05" opacity=".85"/>}
    {(config.showGrid || config.mapType==='zones') && <g stroke="#8D847A" strokeWidth=".2" opacity=".44">
      {Array.from({length:2},(_,i)=><line key={'v'+i} x1={3+(i+1)*64/3} y1="3" x2={3+(i+1)*64/3} y2="107"/>)}
      {Array.from({length:5},(_,i)=><line key={'h'+i} x1="3" y1={3+(i+1)*104/6} x2="67" y2={3+(i+1)*104/6}/>)}
    </g>}
    {(config.mapType==='heatmap'||config.mapType==='zones') && cell.map((n,i)=>{
      const w=64/gridMode[0],h=104/gridMode[1],level=n/Math.max(1,sharedMax);
      return <g key={i}>
        <rect x={3+(i%gridMode[0])*w} y={3+Math.floor(i/gridMode[0])*h} width={w} height={h} fill={fillColor} opacity={n?(0.1+Math.min(.72,level*.72))*opacity:0}/>
        {config.mapType==='zones' && n>0 && <text x={3+(i%gridMode[0]+.5)*w} y={3+(Math.floor(i/gridMode[0])+.52)*h} textAnchor="middle" fontSize="2.65" fontWeight="700" fill="#403B36">{n}</text>}
      </g>;
    })}
    {(config.mapType==='arrows'||config.mapType==='routes') && (config.mapType==='routes'
      ? routes.map((route,i)=><line key={i} x1={route.sx/route.n} y1={route.sy/route.n} x2={route.ex/route.n} y2={route.ey/route.n} stroke={fillColor} strokeWidth={.26+route.n/Math.max(1,routes[0]?.n)*1.2} opacity={opacity} markerEnd={'url(#'+markerId+'-club)'}/>)
      : pitchEvents.map((ev,i)=>{
        if(ev.attack_end_x==null||ev.attack_end_y==null) return null;
        const [x,y]=plotXY(ev),[x2,y2]=plotXY(ev,true);
        const tip=config.colorMode==='outcome'?(ev.is_successful?'win':'lose'):'club';
        return <line key={i} x1={x} y1={y} x2={x2} y2={y2} stroke={strokeFor(ev)}
          strokeWidth={.27*config.lineWidth} opacity={opacity} strokeLinecap="round" markerEnd={'url(#'+markerId+'-'+tip+')'}>
          <title>{String(ev.event_type)} · {Number(ev.minute)}' · {ev.is_successful?'Successful':'Unsuccessful'}</title>
        </line>;
      })
    )}
    {['dots','origins','destinations'].includes(config.mapType) && pitchEvents.map((ev,i)=>{
      if(config.mapType==='destinations' && (ev.attack_end_x==null||ev.attack_end_y==null)) return null;
      const [x,y]=plotXY(ev,config.mapType==='destinations');
      return <circle key={i} cx={x} cy={y} r={scopeNumber(config.markerSize,1,6)*.29} fill={strokeFor(ev)} stroke="#F8F5EF" strokeWidth=".12" opacity={opacity}>
        <title>{String(ev.event_type)} · {Number(ev.minute)}' · {ev.is_successful?'Successful':'Unsuccessful'}</title>
