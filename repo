  '.map-player-total span{color:#796F66;font-size:9px;font-weight:800;letter-spacing:.075em;margin-top:4px}',
  '.map-pitch-wrap{display:flex;align-items:start;justify-content:center;padding:0;background:transparent;border:0;border-radius:0;min-height:0}',
  '.event-pitch-svg{display:block;width:min(100%,460px);height:auto;max-height:none;border-radius:0;overflow:hidden;flex-shrink:1}',
  '.map-player-context{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;min-height:19px;color:#81796E;font-size:10px;margin-top:7px;text-align:center}',
  '.map-footnote{margin-top:14px;padding-top:10px;border-top:1px solid #E3DBD0;color:#81796E;font-size:10px;line-height:1.45}',
  '@media(max-width:800px){.map-output-set{padding:18px 15px 14px}.map-output-grid{column-gap:15px}.map-player-identity strong{font-size:16px}.map-player-identity span{font-size:10px}}',
  '@media(max-width:600px){.map-output-grid{grid-template-columns:1fr;row-gap:22px}.map-output-title{gap:10px;flex-wrap:wrap}.map-attack-label{margin-top:0}.map-player:not(:first-child){padding-top:18px;border-top:1px solid #E3DBD0}.event-pitch-svg{width:min(100%,440px)}}',
].join(NL);

const playerFinderCss = [
  '.player-finder{position:relative}.player-finder input{width:100%;border:1px solid #d9d6cd;background:#fffefa;color:#242936;border-radius:7px;padding:9px 10px;outline:none}',
  '.player-finder input:focus{border-color:#3e6f87;box-shadow:0 0 0 3px #3e6f8720}',
  '.player-suggestions{position:absolute;z-index:60;top:100%;left:0;right:0;max-height:290px;overflow-y:auto;background:#fffefa;border:1px solid #b7c7cd;border-radius:8px;box-shadow:0 14px 28px #25333b2a;margin-top:4px;padding:4px}',
  '.player-suggestions button{display:flex;flex-direction:column;align-items:start;width:100%;background:transparent;border:0;border-radius:6px;text-align:left;padding:9px;cursor:pointer;color:#26343e}',
  '.player-suggestions button:hover,.player-suggestions button:focus{background:#edf3f4;outline:none}',
  '.player-suggestions button strong{font-size:12px;font-weight:760}.player-suggestions button span{font-size:10px;color:#6b7d86}',
  '.player-search-empty{padding:12px;color:#71818b;font-size:11px}',
].join(NL);

export default function SoccerAnalyticsBuilder() {
  const [playerConfigsState, setPlayerConfigs] = useDiveState<PlayerConfig[]>('player_configs', []);
  const [pickedMetrics, setPickedMetrics] = useDiveState<string[]>('metrics', ['goals','assists','shots','chances_created','successful_takeons','progressive_passes']);
  const [basis, setBasis] = useDiveState<'total'|'per90'>('basis', 'total');
  const [mapConfigs, setMapConfigs] = useDiveState<MapConfig[]>('map_configs_v2', []);
  const [mapDraft, setMapDraft] = useDiveState<MapConfig>('map_draft_v2', DEFAULT_MAP);
  const [eventSearch, setEventSearch] = useState('');
  const [savedPreset, setSavedPreset] = useDiveState<string[]>('saved_preset', []);
  const [search, setSearch] = useState('');
  const [playerSearches, setPlayerSearches] = useState<Record<number,string>>({});
  const [activePlayerSearch, setActivePlayerSearch] = useState<number | null>(null);
  const [basisTouched, setBasisTouched] = useState(false);
  const [retrieved, setRetrieved] = useState(false);
  const [exportMessage, setExportMessage] = useState('');
  const { exportQuery } = useExport();

  const scopes = useSQLQuery([
    'SELECT competition, season, COUNT(*) AS player_count',
    'FROM "my_db"."analytics"."player_season_totals_v1"',
    'WHERE competition IS NOT NULL AND season IS NOT NULL',
    'GROUP BY 1,2 ORDER BY competition, season DESC'
  ].join(NL));
  const scopeRows = rows(scopes.data);
  const competitions = Array.from(new Set(scopeRows.map((r) => String(r.competition))));

  const metricQuery = useSQLQuery([
    'SELECT metric_key, display_name, category, source_column, per90_eligible, description, display_order',
    'FROM "my_db"."analytics"."metric_registry_v1"',
    "WHERE registry_kind = 'total_metric' AND user_facing = TRUE",
    "AND list_contains(source_tables, 'analytics.player_season_totals_v1')",
    'ORDER BY category, display_order'
  ].join(NL));

  const indexQuery = useSQLQuery([
    "SELECT competition, season, player_id, player_name, COALESCE(team_names[1], '') AS team_name, appearances, minutes_played",
    'FROM "my_db"."analytics"."player_season_totals_v1"',
    'ORDER BY season DESC, player_name'
  ].join(NL));
  const indexPlayers = rows(indexQuery.data);
  // Player names are global; the competition and seasons are chosen after the player.
  const playerChoices=useMemo(() => {
    const latestById=new Map<string,Row>();
    indexPlayers.forEach((p)=>{
      const key=String(p.player_id);
      const prev=latestById.get(key);
      if(!prev || String(p.season)>String(prev.season)) latestById.set(key,p);
    });
    return Array.from(latestById.values()).sort((a,b)=>String(a.player_name).localeCompare(String(b.player_name)));
  },[indexPlayers]);
  const blankPlayer=():PlayerConfig=>({playerId:'',competition:'',season:'',startSeason:'',endSeason:''});
  const playerConfigs=playerConfigsState.length ? playerConfigsState : [blankPlayer()];
  const hasValidPlayers=playerConfigs.length>0 && playerConfigs.every((cfg)=>
    Boolean(cfg.playerId && cfg.competition && seasonFrom(cfg) && seasonTo(cfg)) &&
    seasonFrom(cfg)<=seasonTo(cfg) &&
    indexPlayers.some((p)=>String(p.player_id)===cfg.playerId && String(p.competition)===cfg.competition &&
      String(p.season)>=seasonFrom(cfg) && String(p.season)<=seasonTo(cfg))
  );
  // One slot per selected player/range; ranges can overlap without merging the players.
  const rangeValues=playerConfigs.length ? playerConfigs.map((cfg,i)=>
    '('+i+','+Number(cfg.playerId)+",'"+safe(cfg.competition)+"','"+safe(seasonFrom(cfg))+"','"+safe(seasonTo(cfg))+"')"
  ).join(',') : "(0,-1,'','0000/0000','0000/0000')";
  const scopeWhere=playerConfigs.length ? playerConfigs.map((cfg)=>
    "(competition = '"+safe(cfg.competition)+"' AND season BETWEEN '"+safe(seasonFrom(cfg))+"' AND '"+safe(seasonTo(cfg))+"')"
  ).filter((v,i,all)=>all.indexOf(v)===i).join(' OR ') : 'FALSE';
  const statsSQL=[
    'WITH requested(selection_slot,player_id,competition,season_from,season_to) AS (VALUES '+rangeValues+'),',
    'aggregated AS (SELECT r.selection_slot,r.player_id,MAX(p.player_name) AS player_name,r.competition,',
    "CASE WHEN r.season_from=r.season_to THEN r.season_from ELSE r.season_from || ' – ' || r.season_to END AS season,",
    'COUNT(DISTINCT p.season) AS seasons_included,MAX(p.team_count) AS team_count,',
    "COALESCE(arg_max(p.team_names[1],p.season),'') AS team_name,",
    'arg_max(p.team_ids[1],p.season) AS display_team_id,',
    ...STAT_SUM_FIELDS.map((field,i)=>'COALESCE(SUM(p."'+field+'"),0) AS "'+field+'"'+(i===STAT_SUM_FIELDS.length-1?'':',')),
    'FROM "my_db"."analytics"."player_season_totals_v1" p',
    'JOIN requested r ON p.player_id=r.player_id AND p.competition=r.competition AND p.season BETWEEN r.season_from AND r.season_to',
    'GROUP BY r.selection_slot,r.player_id,r.competition,r.season_from,r.season_to)',
    'SELECT a.*,c.primary_hex AS team_primary_hex,c.secondary_hex AS team_secondary_hex',
    'FROM aggregated a LEFT JOIN "my_db"."analytics"."team_colors_v1" c ON a.display_team_id=c.team_id',
    'ORDER BY a.selection_slot'
  ].join(NL);
  const statsQuery=useSQLQuery(statsSQL,{enabled:hasValidPlayers});
  const statsPlayers=rows(statsQuery.data).sort((a,b)=>N(a.selection_slot)-N(b.selection_slot));
  const comparisonColors: [string, string] = statsPlayers.length === 2 ? comparisonPalette(statsPlayers[0], statsPlayers[1]) : ['#64748B', '#64748B'];
  const comparisonInk = comparisonColors.map(clubInk);
  const coverageQuery = useSQLQuery([
    'SELECT COUNT(DISTINCT match_id) AS matches, COUNT(DISTINCT event_uid) AS events, COUNT(DISTINCT player_id) AS players,',
    "strftime(MAX(match_date), '%Y-%m-%d') AS latest_match_date",
    'FROM "my_db"."analytics"."canonical_events_v1"',
    'WHERE ' + scopeWhere
  ].join(NL), { enabled: hasValidPlayers });

  const allMetrics = rows(metricQuery.data);
  const filteredMetrics = allMetrics.filter((m) => {
    const q = search.trim().toLowerCase();
    return !q || String(m.display_name).toLowerCase().includes(q) || String(m.source_column).toLowerCase().includes(q);
  });
  const selectedRows = allMetrics.filter((m) => pickedMetrics.includes(String(m.source_column)));
  const groups = useMemo(() => filteredMetrics.reduce<Record<string, Row[]>>((out, metric) => {
    const category = String(metric.category || 'Other');
    (out[category] || (out[category] = [])).push(metric);
    return out;
  }, {}), [filteredMetrics]);
  const coverage = rows(coverageQuery.data)[0] || {};
  const availableMapEvents=EVENT_DEFINITIONS.filter((d)=>d.category===mapDraft.category && d.label.toLowerCase().includes(eventSearch.toLowerCase()));
  const mapDraftPatch=(patch:Partial<MapConfig>)=>setMapDraft({...mapDraft,...patch});
  const addConfiguredMap=()=>{
    if(!mapDraft.eventKeys.length || mapConfigs.length>=8) return;
    const id=Math.max(0,...mapConfigs.map((m)=>m.id))+1;
    setMapConfigs([...mapConfigs,{...mapDraft,id}]);
  };

  const choose = (keys: string[]) => setPickedMetrics(keys.filter((key) => allMetrics.some((m) => String(m.source_column) === key)));
  const toggleMetric = (key: string) => setPickedMetrics(pickedMetrics.includes(key) ? pickedMetrics.filter((item) => item !== key) : [...pickedMetrics, key]);

  const scopesDiffer=playerConfigs.length===2 && (playerConfigs[0].competition!==playerConfigs[1].competition||seasonFrom(playerConfigs[0])!==seasonFrom(playerConfigs[1])||seasonTo(playerConfigs[0])!==seasonTo(playerConfigs[1]));
  const displayBasis = basis; // Ranges show summed totals by default; per-90 remains an explicit choice.
  const ready = Boolean(hasValidPlayers && selectedRows.length);

  const exportResults = async (format: 'csv'|'json') => {
    try {
      setExportMessage('Preparing export…');
      await exportQuery({
        sql: statsSQL,
        format, filename: 'soccer-analytics-comparison'
      });
      setExportMessage('Export started.');
    } catch (error) { setExportMessage('Could not start export: ' + String(error)); }
  };

  return <main className="app">
    <style>{css + NL + resultsCss + NL + mapBuilderCss + NL + editorialMapCss + NL + playerFinderCss}</style>
    <header className="hero"><div><div className="eyebrow">MotherDuck · live soccer intelligence</div><h1>Soccer Analytics Builder</h1><p>Build player comparisons against the canonical data already in <strong>my_db.analytics</strong>. Everything on this screen is live MotherDuck data—there are no API calls or simulated results.</p></div><div className="metric-pill"><strong>{selectedRows.length}</strong> / {allMetrics.length || '—'} metrics selected</div></header>

    <div className="layout">
      <section className="panel">
        <div className="panel-head"><div><h2>1. Players &amp; scope</h2><div className="subtle">Search for any player, then choose their competition and inclusive season range.</div></div><button style={btn()} disabled={playerConfigs.length >= 4} onClick={() => { setPlayerConfigs([...playerConfigs,blankPlayer()]);setPlayerSearches({});setActivePlayerSearch(null);setRetrieved(false); }}>+ Player</button></div>
        <div className="panel-body stack">
          {indexQuery.isLoading ? <div className="empty"><span className="spin" />Loading player index…</div> : playerConfigs.map((config, index) => {
            const fromSeason=seasonFrom(config);
            const toSeason=seasonTo(config);
            const selectedPlayerAnySeason=indexPlayers.find((p)=>String(p.player_id)===config.playerId);
            const availableCompetitions=Array.from(new Set(indexPlayers.filter((p)=>String(p.player_id)===config.playerId)
              .map((p)=>String(p.competition)))).sort();
            const playerSeasons=Array.from(new Set(indexPlayers.filter((p)=>String(p.competition)===config.competition&&String(p.player_id)===config.playerId)
              .map((p)=>String(p.season)))).sort();
            const scopedPlayerRows=indexPlayers.filter((p)=>String(p.competition)===config.competition&&String(p.player_id)===config.playerId&&String(p.season)>=fromSeason&&String(p.season)<=toSeason);
            const selectedPlayer=scopedPlayerRows[0]||selectedPlayerAnySeason;
            const totalAppearances=scopedPlayerRows.reduce((n,p)=>n+N(p.appearances),0);
            const totalMinutes=scopedPlayerRows.reduce((n,p)=>n+N(p.minutes_played),0);
            const typed=playerSearches[index];
            const suggested=typed && typed.trim().length ? playerChoices.filter((p)=>
              String(p.player_name).toLowerCase().includes(typed.trim().toLowerCase())).slice(0,12) : [];
            const updateConfig = (patch: Partial<PlayerConfig>) => {
              const next = playerConfigs.map((item, itemIndex) => itemIndex === index ? { ...item, ...patch } : item);
              setPlayerConfigs(next); setRetrieved(false);
            };
            const choosePlayer=(choice:Row)=>{
              const nextId=String(choice.player_id);
              const available=indexPlayers.filter((p)=>String(p.player_id)===nextId);
              const latest=available.reduce((best,p)=>String(p.season)>String(best.season)?p:best,available[0]);
              const season=String(latest.season),competition=String(latest.competition);
              updateConfig({playerId:nextId,competition,season,startSeason:season,endSeason:season});
              setPlayerSearches((prev)=>({...prev,[index]:String(choice.player_name)}));
              setActivePlayerSearch(null);
            };
            return <article className="player-card" key={index}>
              <div className="player-top"><div className="player-title">Player {index + 1}</div><button style={{ ...btn('ghost'), color: '#bd4e35', padding: '4px 0' }} disabled={playerConfigs.length <= 1} onClick={() => { setPlayerConfigs(playerConfigs.filter((_, i) => i !== index));setPlayerSearches({});setActivePlayerSearch(null);setRetrieved(false); }}>Remove player</button></div>
              <div className="field player-finder">
                <label>Player name · search across all seasons and competitions</label>
                <input type="text" value={typed!==undefined?typed:String(selectedPlayerAnySeason?.player_name||'')}
                  placeholder="Search all players, e.g. Lionel Messi…"
                  autoComplete="off" role="combobox" aria-expanded={activePlayerSearch===index && Boolean(typed?.trim())}
                  aria-autocomplete="list"
                  onFocus={(e)=>{setActivePlayerSearch(index);e.currentTarget.select();}}
                  onBlur={()=>setActivePlayerSearch(null)}
                  onChange={(e)=>{setPlayerSearches((prev)=>({...prev,[index]:e.target.value}));setActivePlayerSearch(index);}}
                  onKeyDown={(e)=>{
                    if(e.key==='Escape') setActivePlayerSearch(null);
                    if(e.key==='Enter'&&suggested.length){e.preventDefault();choosePlayer(suggested[0]);}
                  }}/>
                {activePlayerSearch===index && Boolean(typed?.trim()) && <div className="player-suggestions" role="listbox">
                  {suggested.length?suggested.map((p)=><button type="button" role="option" aria-selected={String(p.player_id)===config.playerId}
                    key={String(p.player_id)}
                    onMouseDown={(e)=>e.preventDefault()}
                    onClick={()=>choosePlayer(p)}>
                    <strong>{String(p.player_name)}</strong>
                    <span>{String(p.team_name||'')} · {String(p.competition)} · {String(p.season)}</span>
                  </button>):<div className="player-search-empty">No players found in the database.</div>}
                </div>}
              </div>
              <div className="scope-card" style={{marginTop:10}}>
                <div className="subtle" style={{fontWeight:700,marginBottom:8}}>Scope {index+1} · {scopedPlayerRows.length} season{scopedPlayerRows.length===1?'':'s'} with data</div>
                <div className="field"><label>Competition</label><select value={config.competition} disabled={!config.playerId} onChange={(e)=>{const nextCompetition=e.target.value;const season=playerSeasons.length && nextCompetition===config.competition?playerSeasons[playerSeasons.length-1]:indexPlayers.filter((p)=>String(p.player_id)===config.playerId&&String(p.competition)===nextCompetition).map((p)=>String(p.season)).sort().slice(-1)[0]||'';updateConfig({competition:nextCompetition,season,startSeason:season,endSeason:season});}}>{!config.playerId&&<option value="">Select a player first</option>}{availableCompetitions.map((value)=><option key={value}>{value}</option>)}</select></div>
                <div className="grid-2" style={{marginTop:9}}>
                  <div className="field"><label>From season</label><select value={fromSeason} disabled={!playerSeasons.length} onChange={(e)=>{const start=e.target.value;const end=start>toSeason?start:toSeason;updateConfig({startSeason:start,endSeason:end,season:end});}}>{playerSeasons.map((v)=><option key={v} value={v}>{v}</option>)}</select></div>
                  <div className="field"><label>To season</label><select value={toSeason} disabled={!playerSeasons.length} onChange={(e)=>{const end=e.target.value;const start=end<fromSeason?end:fromSeason;updateConfig({startSeason:start,endSeason:end,season:end});}}>{playerSeasons.map((v)=><option key={v} value={v}>{v}</option>)}</select></div>
                </div>
                <div className="subtle" style={{marginTop:7}}>Inclusive range · select the same season twice for a single season.</div>
              </div>
              <div className="subtle" style={{marginTop:8}}>{config.playerId?totalAppearances.toLocaleString()+' appearances · '+totalMinutes.toLocaleString()+' recorded minutes · '+String(selectedPlayer?.team_name||'Team not recorded'):'Search and select any player to choose their competitions and seasons.'}</div>
            </article>;
          })}
          <button style={{ ...btn('ghost'), border: '1px dashed #9db9c6', color: '#3e6f87', width: '100%' }} disabled={playerConfigs.length >= 4} onClick={() => { setPlayerConfigs([...playerConfigs,blankPlayer()]);setPlayerSearches({});setActivePlayerSearch(null);setRetrieved(false); }}>+ Add another player</button>

          <details className="category map-builder" open>
            <summary className="category-summary"><span className="summary-left">Event Map Builder</span><span className="count">{mapConfigs.length} configured</span></summary>
            <div className="map-builder-inner">
              <div className="map-builder-note">Inherits each player's competition and selected season range. One map setup is applied to every selected player.</div>
              <details className="map-box"><summary>01 · Event Selection <span className="subtle">{mapDraft.category} · {mapDraft.eventKeys.length} types</span></summary>
                <div className="map-options">
                  <div className="map-field"><label>Category</label><select value={mapDraft.category} onChange={(e)=>{const category=e.target.value as MapCategory;const first=EVENT_DEFINITIONS.find((d)=>d.category===category);mapDraftPatch({category,eventKeys:first?[first.id]:[],mapType:category==='Passing'?'arrows':'dots'});setEventSearch('');}}>{MAP_CATEGORIES.map((cat)=><option key={cat}>{cat}</option>)}</select></div>
                  <div className="map-field"><label>Search event types</label><input value={eventSearch} onChange={(e)=>setEventSearch(e.target.value)} placeholder="Search events or tags…"/></div>
                  <div className="map-event-choices">{availableMapEvents.map((def)=><label key={def.id} className="map-event-choice"><input type="checkbox" checked={mapDraft.eventKeys.includes(def.id)} onChange={(e)=>mapDraftPatch({eventKeys:e.target.checked?[...mapDraft.eventKeys,def.id]:mapDraft.eventKeys.filter((v)=>v!==def.id)})}/>{def.label}</label>)}</div>
                  <div className="map-field"><label>Event outcome</label><select value={mapDraft.outcome} onChange={(e)=>mapDraftPatch({outcome:e.target.value})}><option value="all">All outcomes</option><option value="successful">Successful</option><option value="unsuccessful">Unsuccessful</option></select></div>
                </div>
              </details>
              <details className="map-box"><summary>02 · Event Filters <span className="subtle">{mapDraft.playType==='all'?'All play':'Filtered play'} · {mapDraft.fromMinute}–{mapDraft.toMinute}'</span></summary>
                <div className="map-options">
                  <div className="map-field"><label>Play type</label><select value={mapDraft.playType} onChange={(e)=>mapDraftPatch({playType:e.target.value})}><option value="all">All play</option><option value="open">Open play (untagged set pieces)</option><option value="set">Set pieces</option><option value="corner">Corners</option><option value="freekick">Free kicks</option></select></div>
                  <div className="map-field-grid">
                    <div className="map-field"><label>From minute</label><input type="number" min="0" max="140" value={mapDraft.fromMinute} onChange={(e)=>mapDraftPatch({fromMinute:Number(e.target.value)})}/></div>
                    <div className="map-field"><label>To minute</label><input type="number" min="0" max="140" value={mapDraft.toMinute} onChange={(e)=>mapDraftPatch({toMinute:Number(e.target.value)})}/></div>
                  </div>
                  {mapDraft.category==='Passing' && <>
                    <div className="map-field"><label>Pass direction</label><select value={mapDraft.direction} onChange={(e)=>mapDraftPatch({direction:e.target.value})}><option value="all">All directions</option><option value="forward">Forward</option><option value="backward">Backward</option><option value="lateral">Lateral</option></select></div>
                    <div className="map-field-grid"><div className="map-field"><label>Min length (pitch units)</label><input type="number" min="0" max="140" value={mapDraft.minDistance} onChange={(e)=>mapDraftPatch({minDistance:Number(e.target.value)})}/></div><div className="map-field"><label>Max length (pitch units)</label><input type="number" min="0" max="140" value={mapDraft.maxDistance} onChange={(e)=>mapDraftPatch({maxDistance:Number(e.target.value)})}/></div></div>
                  </>}
                </div>
              </details>
              <details className="map-box"><summary>03 · Pitch Location <span className="subtle">{mapDraft.startThird==='all'?'All start zones':mapDraft.startThird}</span></summary>
                <div className="map-options">
                  <div className="map-field-grid">
                    <div className="map-field"><label>Starting third</label><select value={mapDraft.startThird} onChange={(e)=>mapDraftPatch({startThird:e.target.value})}>{[['all','All thirds'],['defensive','Defensive'],['middle','Middle'],['attacking','Attacking']].map(([v,l])=><option key={v} value={v}>{l}</option>)}</select></div>
                    <div className="map-field"><label>Starting lane</label><select value={mapDraft.startLane} onChange={(e)=>mapDraftPatch({startLane:e.target.value})}>{[['all','All lanes'],['left','Left'],['center','Center'],['right','Right']].map(([v,l])=><option key={v} value={v}>{l}</option>)}</select></div>
                    <div className="map-field"><label>Start zone (18-grid)</label><select value={mapDraft.startZone} onChange={(e)=>mapDraftPatch({startZone:Number(e.target.value)})}><option value={0}>Any zone</option>{Array.from({length:18},(_,i)=><option key={i+1} value={i+1}>Zone {i+1}</option>)}</select></div>
                    {mapDraft.category==='Passing' && <div className="map-field"><label>End zone (18-grid)</label><select value={mapDraft.endZone} onChange={(e)=>mapDraftPatch({endZone:Number(e.target.value)})}><option value={0}>Any zone</option>{Array.from({length:18},(_,i)=><option key={i+1} value={i+1}>Zone {i+1}</option>)}</select></div>}
                    {mapDraft.category==='Passing' && <div className="map-field"><label>Ending third</label><select value={mapDraft.endThird} onChange={(e)=>mapDraftPatch({endThird:e.target.value})}>{[['all','All thirds'],['defensive','Defensive'],['middle','Middle'],['attacking','Attacking']].map(([v,l])=><option key={v} value={v}>{l}</option>)}</select></div>}
                    {mapDraft.category==='Passing' && <div className="map-field"><label>Ending lane</label><select value={mapDraft.endLane} onChange={(e)=>mapDraftPatch({endLane:e.target.value})}>{[['all','All lanes'],['left','Left'],['center','Center'],['right','Right']].map(([v,l])=><option key={v} value={v}>{l}</option>)}</select></div>}
                  </div>
                </div>
              </details>
              <details className="map-box"><summary>04 · Map Appearance <span className="subtle">{MAP_STYLES.find((m)=>m.value===mapDraft.mapType)?.label} · {mapDraft.pitchView}</span></summary>
                <div className="map-options">
                  <div className="map-field-grid">
                    <div className="map-field"><label>Map type</label><select value={mapDraft.mapType} onChange={(e)=>mapDraftPatch({mapType:e.target.value as MapStyle})}>{MAP_STYLES.filter((m)=>mapDraft.category==='Passing'||!['arrows','origins','destinations','routes','sonar'].includes(m.value)).map((m)=><option key={m.value} value={m.value}>{m.label}</option>)}</select></div>
                    <div className="map-field"><label>Pitch view</label><select value={mapDraft.pitchView} onChange={(e)=>mapDraftPatch({pitchView:e.target.value})}><option value="full">Full pitch</option><option value="attacking">Attacking half</option><option value="final">Final third</option></select></div>
                    <div className="map-field"><label>Colors</label><select value={mapDraft.colorMode} onChange={(e)=>mapDraftPatch({colorMode:e.target.value})}><option value="team">Club colors</option><option value="outcome">Outcome colors</option></select></div>
                    <div className="map-field"><label>Size {mapDraft.markerSize}</label><input type="range" min="1" max="6" value={mapDraft.markerSize} onChange={(e)=>mapDraftPatch({markerSize:Number(e.target.value)})}/></div>
                    <div className="map-field"><label>Line width {mapDraft.lineWidth}</label><input type="range" min="1" max="5" value={mapDraft.lineWidth} onChange={(e)=>mapDraftPatch({lineWidth:Number(e.target.value)})}/></div>
                    <div className="map-field"><label>Opacity {mapDraft.opacity}%</label><input type="range" min="10" max="100" value={mapDraft.opacity} onChange={(e)=>mapDraftPatch({opacity:Number(e.target.value)})}/></div>
                  </div>
                  <label className="map-event-choice"><input type="checkbox" checked={mapDraft.showGrid} onChange={(e)=>mapDraftPatch({showGrid:e.target.checked})}/>Show 18-zone pitch grid</label>
                </div>
              </details>
              <div className="map-btnrow"><button style={btn('primary')} disabled={!mapDraft.eventKeys.length||mapConfigs.length>=8} onClick={addConfiguredMap}>+ Add map</button><button style={btn('ghost')} onClick={()=>{setMapDraft(DEFAULT_MAP);setEventSearch('');}}>Reset builder</button><button style={btn('ghost')} disabled={!mapConfigs.length} onClick={()=>setMapConfigs([])}>Clear maps</button></div>
              {mapConfigs.length>0 && <div className="map-queue">{mapConfigs.map((cfg,i)=><div className="map-queue-row" key={cfg.id}><span><strong>{i+1}.</strong> {mapLabel(cfg)} · {MAP_STYLES.find((m)=>m.value===cfg.mapType)?.label}</span><div className="tool-row"><button style={{...btn('ghost'),padding:'2px 5px'}} onClick={()=>setMapDraft({...cfg,id:0})}>Edit copy</button><button style={{...btn('ghost'),padding:'2px 5px',color:'#b34c3b'}} onClick={()=>setMapConfigs(mapConfigs.filter((m)=>m.id!==cfg.id))}>Remove</button></div></div>)}</div>}
              <div className="map-builder-note">Add up to eight map configurations. All selected players get identical filters and chart scales in Section 4. Event maps appear after Retrieve statistics.</div>
            </div>
          </details>
          <div className="notice">Scope and player choices come directly from the season-total table. The builder only exposes metrics present in your live registry.</div>
        </div>
      </section>

      <section className="panel">
        <div className="panel-head"><div><h2>2. Select statistics</h2><div className="subtle">The categories are sourced from the live metric registry, not a hard-coded API catalog.</div></div><button style={btn('ghost')} onClick={() => setSavedPreset(pickedMetrics)}>Save current preset</button></div>
        <div className="panel-body"><div className="toolbar"><div className="search-wrap"><span>⌕</span><input className="search" value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Search metrics or database fields…" /></div><div className="tool-row"><button style={preset()} onClick={() => choose(['goals','assists','shots','chances_created','successful_takeons','progressive_passes'])}>General overview</button><button style={preset()} onClick={() => choose(['goals','penalty_goals','non_penalty_goals','shots','shots_on_target','big_chances','big_chances_missed'])}>Goalscoring</button><button style={preset()} onClick={() => choose(['assists','chances_created','big_chances_created','passes','progressive_passes','through_balls'])}>Playmaking</button><button style={preset()} onClick={() => choose(['takeons','successful_takeons','touches','dispossessions'])}>Dribbling</button>{savedPreset.length > 0 && <button style={preset()} onClick={() => choose(savedPreset)}>Saved preset</button>}<button style={btn('ghost')} onClick={() => setPickedMetrics(allMetrics.map((m) => String(m.source_column)))}>Select all</button><button style={btn('ghost')} onClick={() => setPickedMetrics([])}>Clear all</button><div className="basis"><button className={displayBasis === 'total' ? 'active' : ''} onClick={() => { setBasisTouched(true); setBasis('total'); }}>Totals</button><button className={displayBasis === 'per90' ? 'active' : ''} onClick={() => { setBasisTouched(true); setBasis('per90'); }}>Per 90</button></div></div><div className="subtle">Metrics only convert per 90 when the live registry marks them eligible and the selected player has recorded minutes.</div></div>
          {metricQuery.isLoading ? <div className="empty"><span className="spin" />Loading metric registry…</div> : Object.entries(groups).map(([category, metrics]) => { const selected = metrics.filter((m) => pickedMetrics.includes(String(m.source_column))).length; return <details className="category" key={category} open={Boolean(search)}><summary className="category-summary"><span className="summary-left">{category}</span><span className="count">{selected} selected</span></summary><div className="metrics">{metrics.map((metric) => { const key = String(metric.source_column); return <label className="metric" key={key}><input type="checkbox" checked={pickedMetrics.includes(key)} onChange={() => toggleMetric(key)} /><span><b>{String(metric.display_name)}</b><code>{key}{Boolean(metric.per90_eligible) ? ' · per 90 eligible' : ''}</code></span></label>; })}</div></details>; })}
          {!filteredMetrics.length && <div className="empty">No metric names or database fields match this search.</div>}
          <div className="footerbar"><div className={'validation ' + (ready ? 'good' : '')}>{ready ? 'Ready to retrieve live MotherDuck results.' : 'Select each player, a valid scope, and at least one metric to retrieve.'}</div><div className="tool-row"><button style={btn('ghost')} onClick={() => setRetrieved(false)}>Reset results</button><button style={btn('primary')} disabled={!ready} onClick={() => setRetrieved(true)}>Retrieve statistics</button></div></div>
        </div>
      </section>
    </div>

    <section className="panel results-panel"><div className="panel-head"><div><h2>3. Retrieved statistics</h2><div className="subtle">{retrieved ? statsPlayers.length + ' player' + (statsPlayers.length === 1 ? '' : 's') + ' · independently scoped comparisons' + (scopesDiffer && !basisTouched ? ' · separately selected season ranges' : '') : 'Your selected statistics will appear here after retrieval.'}</div></div><div className="tool-row"><button style={btn()} disabled={!retrieved} onClick={() => exportResults('csv')}>Download CSV</button><button style={btn()} disabled={!retrieved} onClick={() => exportResults('json')}>Download JSON</button></div></div><div className="panel-body">{!retrieved ? <div className="notice">Select players and statistics above, then press <strong>Retrieve statistics</strong>. No placeholder values are shown.</div> : <>{exportMessage && <div className="notice" style={{marginBottom:12}}>{exportMessage}</div>}<div className="results-scroll">{statsPlayers.length === 2 ? <div className="head-to-head"><div className="compare-players"><div className="compare-player"><div className="compare-name"><span aria-hidden="true" style={{display:'inline-block',width:9,height:9,borderRadius:'50%',background:comparisonColors[0],border:'1px solid #7d8790',marginRight:7}} />{String(statsPlayers[0].player_name)}</div><div className="compare-scope">{String(statsPlayers[0].team_name || 'No team')} · {String(statsPlayers[0].competition)} · {String(statsPlayers[0].season)}</div></div><div className="dominance-key" aria-hidden="true" /><div className="compare-player right"><div className="compare-name"><span aria-hidden="true" style={{display:'inline-block',width:9,height:9,borderRadius:'50%',background:comparisonColors[1],border:'1px solid #7d8790',marginRight:7}} />{String(statsPlayers[1].player_name)}</div><div className="compare-scope">{String(statsPlayers[1].team_name || 'No team')} · {String(statsPlayers[1].competition)} · {String(statsPlayers[1].season)}</div></div></div>{selectedRows.map((metric) => {
  const values = statsPlayers.map((player) => metricNumber(player, metric, displayBasis === 'per90'));
  const leftValue = values[0];
  const rightValue = values[1];
  const winner = Math.max(leftValue, rightValue);
  const runner = Math.min(leftValue, rightValue);
  const tied = leftValue === rightValue;
  const leaderIndex = leftValue >= rightValue ? 0 : 1;
  const leadPct = !tied && runner > 0 ? Math.round(((winner - runner) / runner) * 100) : 0;
  const visualLead = !tied ? (runner > 0 ? Math.min(leadPct, 100) : 100) : 0;
  const markerPosition = 50 + (leaderIndex === 0 ? -1 : 1) * visualLead / 2;
  const markerColor = tied ? '#64748b' : comparisonColors[leaderIndex];
  const fillLeft = Math.min(50, markerPosition);
  const fillWidth = Math.abs(markerPosition - 50);
  const leaderName = String(statsPlayers[leaderIndex].player_name);
  const caption = tied ? 'Even' : runner > 0 ? 'Leader: ' + leaderName + ' · +' + leadPct + '%' : 'Leader: ' + leaderName + ' · only recorded value';
  const numberClass = !tied ? (leaderIndex === 0 ? 'leader-left' : 'leader-right') : '';
  return <div className="compare-row" key={String(metric.source_column)}><div className={'compare-value ' + numberClass}><span className="compare-number" style={{color:comparisonInk[0]}}><Value player={statsPlayers[0]} metric={metric} per90={displayBasis === 'per90'} /></span></div><div className="metric-center"><span className="metric-name">{String(metric.display_name)}</span><div className="dominance-rail" title={String(statsPlayers[0].player_name) + ': ' + leftValue.toLocaleString() + ' · ' + String(statsPlayers[1].player_name) + ': ' + rightValue.toLocaleString()}><span className="dominance-midpoint" /><span className="dominance-fill" style={{left: fillLeft + '%', width: fillWidth + '%', background: markerColor}} /><span className="dominance-marker" style={{left: markerPosition + '%', background: markerColor}} /></div><span className={'leader-caption ' + (tied ? 'even' : leaderIndex === 0 ? 'left' : 'right')} style={{color:tied ? undefined : '#00A957'}}>{caption}</span></div><div className={'compare-value right ' + numberClass}><span className="compare-number" style={{color:comparisonInk[1]}}><Value player={statsPlayers[1]} metric={metric} per90={displayBasis === 'per90'} /></span></div></div>;
})}</div> : <table className="results-table"><thead><tr><th>Metric</th>{statsPlayers.map((player) => <th key={String(player.player_id)}>{String(player.player_name)}<span className="scope-chip">{String(player.team_name || 'No team')} · {String(player.competition)} · {String(player.season)}</span></th>)}</tr></thead><tbody>{selectedRows.map((metric) => <tr key={String(metric.source_column)}><th className="metric-label">{String(metric.display_name)}</th>{statsPlayers.map((player) => <td className="stat-number" key={String(player.player_id)} style={{color:clubInk(clubDisplayColor(player))}}><Value player={player} metric={metric} per90={displayBasis === 'per90'} /></td>)}</tr>)}</tbody></table>}</div></>}<div className="notice" style={{marginTop:14}}>Coverage across selected scopes: <strong>{N(coverage.matches).toLocaleString()}</strong> matches · <strong>{N(coverage.players).toLocaleString()}</strong> players · <strong>{N(coverage.events).toLocaleString()}</strong> canonical events · latest recorded match {String(coverage.latest_match_date || '—')}.</div></div></section>


    {retrieved && mapConfigs.length>0 && <section className="panel results-panel">
      <div className="panel-head"><div><h2>4. Retrieved event maps</h2><div className="subtle">Shared map settings · player-specific competition, season, and club colors · attacking upward.</div></div><span className="count">{mapConfigs.length} map {mapConfigs.length===1?'type':'types'}</span></div>
      <div className="panel-body">{mapConfigs.map((cfg)=><EventMapResult key={cfg.id} config={cfg} playerConfigs={playerConfigs} rangeValues={rangeValues} statsPlayers={statsPlayers}/>)}</div>
    </section>}
  </main>;
}
