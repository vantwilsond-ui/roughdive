      })}
      <circle cx="35" cy="55" r=".7" fill="#655F58"/>
    </g>}
  </svg>;
}
function EventMapResult({config,playerConfigs,rangeValues,statsPlayers}: {config:MapConfig;playerConfigs:PlayerConfig[];rangeValues:string;statsPlayers:Row[]}) {
  const eventFilter=mapWhere(config);
  const sql=[
    'WITH selected_ranges(selection_slot,player_id,competition,season_from,season_to) AS (VALUES '+rangeValues+'),',
    'deduplicated AS (SELECT r.selection_slot,e.event_uid,e.player_id,e.competition,e.season,e.event_type,e.minute,',
    'e.attack_x,e.attack_y,e.attack_end_x,e.attack_end_y,e.start_zone_18,e.end_zone_18,e.is_successful,',
    'e.match_id,e.match_date,e.sequence_index,',
    'ROW_NUMBER() OVER (PARTITION BY r.selection_slot,e.event_uid ORDER BY e.source_row_id) AS dedup_rank',
    'FROM "my_db"."analytics"."canonical_events_v1" e',
    'JOIN selected_ranges r ON e.player_id=r.player_id AND e.competition=r.competition',
    'AND e.season BETWEEN r.season_from AND r.season_to',
    'WHERE ('+eventFilter+')',
    '), filtered AS (SELECT * FROM deduplicated WHERE dedup_rank=1),',
    'ranked AS (SELECT *,COUNT(*) OVER (PARTITION BY selection_slot) AS total_events,',
    'SUM(CASE WHEN is_successful THEN 1 ELSE 0 END) OVER (PARTITION BY selection_slot) AS successful_events,',
    'ROW_NUMBER() OVER (PARTITION BY selection_slot ORDER BY hash(event_uid)) AS sample_rank',
    'FROM filtered)',
    'SELECT * FROM ranked WHERE sample_rank <= 1200'
  ].join(NL);
  const result=useSQLQuery(sql);
  const allEvents=rows(result.data);
  const dataByPlayer=playerConfigs.map((_,i)=>allEvents.filter((ev)=>N(ev.selection_slot)===i));
  const sharedMax=Math.max(1,...dataByPlayer.flatMap((data) =>
    config.mapType==='sonar'?sonarCounts(data):config.mapType==='heatmap'?cellCounts(data,7,10):cellCounts(data,3,6)));
  const colors=statsPlayers.length===2?comparisonPalette(statsPlayers[0],statsPlayers[1]):[];
  const completedOnly=config.outcome==='successful' || config.eventKeys.every((key)=>['completed_passes','takeons_success','tackles_success','aerials_won'].includes(key));
  const countLabel=completedOnly?'COMPLETED':(config.eventKeys.length===1&&config.eventKeys[0]==='goals'?'GOALS':'EVENTS');
  const subtitle=config.eventKeys.length===1&&config.eventKeys[0]==='final_third_pass'
    ? 'Passes crossing into the final third · '+(config.outcome==='all'?'all outcomes':config.outcome+' only')
    : MAP_STYLES.find((m)=>m.value===config.mapType)?.label+' · '+(config.outcome==='all'?'all outcomes':config.outcome+' only')+' · shared map settings';
  return <article className="map-output-set">
    <div className="map-output-title">
      <div><h3>{mapLabel(config)}</h3><p>{subtitle}</p></div>
      <div className="map-attack-label">ATTACK DIRECTION <span aria-hidden="true">↑</span></div>
    </div>
    {result.isLoading ? <div className="empty"><span className="spin"/>Loading deduplicated match events…</div> :
      result.isError ? <div className="notice warn">Unable to load event map: {String(result.error)}</div> :
      <div className="map-output-grid">{playerConfigs.map((player,i)=>{
        const data=dataByPlayer[i];
        const total=data.length?N(data[0].total_events):0;
        const plotted=data.length;
        const statPlayer=statsPlayers[i]||{};
        const color=colors[i]||clubDisplayColor(statPlayer);
        const statColor=clubInk(color);
        const comparable=['Passing','Dribbling','Defending'].includes(config.category);
        const success=plotted?N(data[0].successful_events):0;
        return <section className="map-player" key={i}>
          <div className="map-player-head">
            <div className="map-player-identity">
              <strong>{String(statPlayer.player_name||player.playerId)}</strong>
              <span>{seasonLabel(player)} · {String(statPlayer.team_name||'')} · {player.competition}</span>
            </div>
            <div className="map-player-total" style={{color:statColor}}>
              <strong>{total.toLocaleString()}</strong><span>{countLabel}</span>
            </div>
          </div>
          <div className="map-pitch-wrap"><EventPitch data={data} config={config} color={color} sharedMax={sharedMax} instanceId={String(i)+'-'+player.playerId}/></div>
          <div className="map-player-context">
            {comparable && total>0 && <span>{(100*success/total).toFixed(1)}% marked successful</span>}
            {total>plotted && <span>{plotted.toLocaleString()} of {total.toLocaleString()} events drawn (stable sample)</span>}
            {total===0 && <span>No matching location-bearing events for this player and scope.</span>}
          </div>
        </section>;
      })}</div>}
    <div className="map-footnote">Distinct event IDs · identical pitch orientation and display scales · up to 1,200 events per player across their season range. Progressive passes and directional/distance filters are derived from event coordinates.</div>
  </article>;
}


