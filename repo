const metricNumber = (player: Row, metric: Row, per90: boolean) => {
  const total = N(player[String(metric.source_column)]);
  const minutes = N(player.minutes_played);
  return per90 && Boolean(metric.per90_eligible) && minutes > 0 ? total * 90 / minutes : total;
};
function Value({ player, metric, per90 }: { player: Row; metric: Row; per90: boolean }) {
  const value = metricNumber(player, metric, per90);
  return <>{Number.isFinite(value) ? value.toLocaleString(undefined, { maximumFractionDigits: per90 && Boolean(metric.per90_eligible) ? 2 : 0 }) : '—'}{per90 && Boolean(metric.per90_eligible) && N(player.minutes_played) > 0 ? ' /90' : ''}</>;
}


const normalizeClubHex = (v: unknown, fallback: string): string => {
  const c = String(v ?? '');
  return /^#[0-9a-fA-F]{6}$/.test(c) ? c.toUpperCase() : fallback;
};
const rgbOf = (c: string): number[] => [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
const mixHex = (a: string, b: string, t: number): string => {
  const av = rgbOf(a), bv = rgbOf(b);
  return '#' + av.map((n, i) => Math.round(n * (1 - t) + bv[i] * t).toString(16).padStart(2, '0')).join('').toUpperCase();
};
const lightness = (hex: string): number => {
  const r = rgbOf(hex).map((v) => {
    const n = v / 255;
    return n <= 0.04045 ? n / 12.92 : Math.pow((n + 0.055) / 1.055, 2.4);
  });
  return r[0] * 0.2126 + r[1] * 0.7152 + r[2] * 0.0722;
};
const contrastRatio = (a: string, b: string): number => {
  const l = lightness(a), r = lightness(b);
  return (Math.max(l, r) + 0.05) / (Math.min(l, r) + 0.05);
};
const oklab = (hex: string): number[] => {
  const [r, g, b] = rgbOf(hex).map((v) => {
    const n = v / 255;
    return n <= 0.04045 ? n / 12.92 : Math.pow((n + 0.055) / 1.055, 2.4);
  });
  const l = Math.cbrt(0.4122214708*r + 0.5363325363*g + 0.0514459929*b);
  const m = Math.cbrt(0.2119034982*r + 0.6806995451*g + 0.1073969566*b);
  const s = Math.cbrt(0.0883024619*r + 0.2817188376*g + 0.6299787005*b);
  return [
    0.2104542553*l + 0.7936177850*m - 0.0040720468*s,
    1.9779984951*l - 2.4285922050*m + 0.4505937099*s,
    0.0259040371*l + 0.7827717662*m - 0.8086757660*s,
  ];
};
const perceptualGap = (a: string, b: string): number => {
  const l = oklab(a), r = oklab(b);
  return Math.hypot(l[0]-r[0], l[1]-r[1], l[2]-r[2]) * 100;
};
const clubDisplayColor = (player: Row): string => {
  const primary = normalizeClubHex(player.team_primary_hex, '#64748B');
  const alternate = normalizeClubHex(player.team_secondary_hex, '#334155');
  // White or nearly-white club colors use the dark secondary on the light chart.
  return contrastRatio(primary, '#FFFEFA') < 1.5 && contrastRatio(alternate, '#FFFEFA') >= 1.5 ? alternate : primary;
};
const clubInk = (color: string): string => {
  let ink = color;
  for (let i = 0; i < 12 && contrastRatio(ink, '#FFFEFA') < 4.5; i++) {
    ink = mixHex(ink, '#111827', 0.18);
  }
  return ink;
};
const comparisonPalette = (left: Row, right: Row): [string, string] => {
  const a = clubDisplayColor(left), b = clubDisplayColor(right);
  if (perceptualGap(a, b) >= 18) return [a, b];
  const sa = normalizeClubHex(left.team_secondary_hex, '#334155');
  const sb = normalizeClubHex(right.team_secondary_hex, '#334155');
  const choices: [string, string, number][] = [[a, b, 0], [sa, b, 1], [a, sb, 1], [sa, sb, 2]];
  const allowed = choices.filter(([l, r]) => contrastRatio(l, '#FFFEFA') >= 1.5 && contrastRatio(r, '#FFFEFA') >= 1.5);
  allowed.sort((x, y) => (Math.min(perceptualGap(y[0], y[1]), 60) - y[2] * 12) - (Math.min(perceptualGap(x[0], x[1]), 60) - x[2] * 12));
  let result: [string, string] = allowed.length ? [allowed[0][0], allowed[0][1]] : [a, b];
  // When two clubs still have matching palettes, keep the hue family but separate brightness.
  if (perceptualGap(result[0], result[1]) < 18) {
    result = [result[0], mixHex(result[1], lightness(result[1]) < 0.16 ? '#FFFFFF' : '#111827', 0.52)];
  }
  return result;
};


